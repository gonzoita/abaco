# Copia este archivo a .env y ajusta los valores para tu entorno.
# .env está en .gitignore -- nunca subas el real con credenciales.

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=control_finanzas
DB_USER=root
DB_PASS=

# Seguridad -- genera uno propio, no uses este valor en producción
# (ej: openssl rand -hex 32)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Solo en el servidor de producción: secreto compartido con el webhook de
# GitHub que dispara deploy.php (ver README, sección Deploy). No hace falta
# en desarrollo local.
GITHUB_WEBHOOK_SECRET=
